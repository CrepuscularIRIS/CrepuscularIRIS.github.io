907]},"uRainbow":{"value":0},"uSunRays":{"value":0.25},"uCityGlow":{"value":0},"uCityColor":{"type":"c","value":16744640},"uAuroraLow":{"type":"c","value":4259728},"uAuroraMid":{"type":"c","value":3203280},"uAuroraTop":{"type":"c","value":10510591},"uExposure":{"value":1}},"vertexShader":"\n  varying vec3 vDir;\n  void main(){\n    vDir = normalize(position);\n    vec4 p = projectionMatrix * modelViewMatrix * vec4(position, 1.0);\n    gl_Position = p.xyww; /* at the far plane */\n  }","fragmentShader":"\n  varying vec3 vDir;\n  uniform float uExposure;\n  \n  uniform vec3 uSunDir, uZenith, uHorizon, uGround, uSunColor, uCloudLit, uCloudShade, uGlow;\n  uniform float uTime, uSunSize, uSunPower, uGradPow, uHaze;\n  uniform float uCover, uCloudAlt, uCloudScale, uCloudSoft, uCloudDark, uCloudLayerHigh, uCloudBase, uCloudVert;\n  uniform float uStars, uAurora, uAuroraSeed, uAuroraStyle, uMoon, uRainbow, uSunRays, uCityGlow;\n  uniform vec3 uMoonDir, uCityColor;\n  uniform vec3 uAuroraLow, uAuroraMid, uAuroraTop;\n\n  float skyHash(vec3 p){ p = fract(p * 0.3183099 + 0.1); p *= 17.0; return fract(p.x * p.y * p.z * (p.x + p.y + p.z)); }\n  float skyHash2(vec2 p){ vec3 p3 = fract(vec3(p.xyx) * 0.1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }   // sin-free: sin() hashes band and block on real GPUs\n  float skyNoise(vec2 p){\n    vec2 i = floor(p), f = fract(p); f = f * f * (3.0 - 2.0 * f);\n    return mix(mix(skyHash2(i), skyHash2(i + vec2(1, 0)), f.x), mix(skyHash2(i + vec2(0, 1)), skyHash2(i + vec2(1, 1)), f.x), f.y);\n  }\n  float skyFbm(vec2 p){ float a = 0.5, s = 0.0; for (int i = 0; i < 5; i++) { s += a * skyNoise(p); p = p * 2.03 + vec2(17.1, 9.2); a *= 0.5; } return s; }\n\n  /* cellular puffs: round blobs of random size per cell, so clouds read as separate cumulus with gaps between them */\n  float skyCell(vec2 p){\n    vec2 i = floor(p), f = fract(p); float m = 0.0;\n    for (int y = -1; y <= 1; y++) for (int x = -1; x <= 1; x++) {\n      vec2 g = vec2(float(x), float(y));\n      vec2 o = vec2(skyHash2(i + g), skyHash2(i + g + 17.3));\n      float r = 0.30 + 0.34 * skyHash2(i + g + 3.1);\n      float dd = length(g + o - f) / r;\n      m = max(m, smoothstep(1.0, 0.25, dd) * (0.55 + 0.45 * skyHash2(i + g + 9.0)));\n    }\n    return m;\n  }\n  /* cumulus layer: density on a plane at altitude uCloudAlt */\n  float cloudDensity(vec2 p){\n    float big = skyCell(p * 0.5);\n    float mid = skyCell(p * 1.1 + 4.2);\n    float small = skyCell(p * 2.6 + 8.7);\n    float d = (big * 0.62 + mid * 0.42) * (0.75 + 0.55 * small) * (0.6 + 0.8 * skyFbm(p * 1.7));   // lumpy union of bumps, ragged edge\n    float thr = 0.62 - 0.4 * uCover;\n    return smoothstep(thr, thr + uCloudSoft, d);\n  }\n\n  vec3 skyColor(vec3 d){\n    float sunUp = smoothstep(-0.12, 0.08, uSunDir.y);       // 0 at night, 1 by day\n    float h = d.y;\n    float sd = max(dot(d, uSunDir), 0.0);\n\n    /* gradient: ground haze below the horizon, horizon band, then zenith */\n    vec3 col = mix(uHorizon, uZenith, pow(clamp(h, 0.0, 1.0), uGradPow));\n    col = mix(col, uGround, smoothstep(0.0, -0.35, h));\n    /* warm scattering toward the sun, a broad one and a tight one */\n    col += uGlow * (pow(sd, 6.0) * 0.10 + pow(sd, 40.0) * 0.45) * (1.0 - clamp(h * 1.4, 0.0, 0.7));\n    /* sun disc with a soft edge and a bright core */\n    float disc = smoothstep(uSunSize, uSunSize * 0.82, 1.0 - sd);\n    col += uSunColor * (disc * uSunPower + pow(sd, 900.0) * uSunPower * 0.6);\n\n    /* stars: fixed cells, steady brightness (no twinkle) */\n    if (uStars > 0.0 && h > 0.0) {\n      vec3 q = d * 260.0; vec3 c = floor(q); float r = skyHash(c);\n      float star = step(0.9965, r) * smoothstep(0.32, 0.0, length(fract(q) - 0.5)) * (0.45 + 0.4 * skyHash(c + 7.0));\n      col += vec3(0.9, 0.95, 1.0) * star * uStars * (1.0 - sunUp) * smoothstep(0.0, 0.15, h);\n    }\n\n    /* aurora (Lux / Photon style): style 0 stacked curtains, 1 folded ribbons, 2 vertical ray corona */\n    if (uAurora > 0.001 && h > 0.04) {\n      vec3 a = vec3(0.0);\n      float az0 = atan(d.x, -d.z);\n      if (uAuroraStyle < 1.5) {\n        for (int i = 0; i < 10; i++) {\n          float fi = float(i) / 9.0;\n          float alt = mix(2.2, 5.5, fi);\n          float t = alt / h;\n          vec2 p = d.xz * t * 0.16 + vec2(uAuroraSeed, uTime * 0.012);\n          if (uAuroraStyle > 0.5) p.x += sin(p.y * 2.3 + uTime * 0.05 + fi * 3.0) * 0.55;   // folds\n          float ridge = 1.0 - abs(2.0 * skyFbm(vec2(p.x * 0.9, p.y * 0.35)) - 1.0);\n          float curtain = pow(ridge, mix(5.0, 9.0, step(0.5, uAuroraStyle))) * smoothstep(0.0, 0.35, skyFbm(p * 0.5 + 9.0));\n          vec3 c = mix(uAuroraLow, mix(uAuroraMid, uAuroraTop, smoothstep(0.45, 1.0, fi)), smoothstep(0.0, 0.55, fi));\n          a += c * curtain * (0.35 + 0.65 * (1.0 - fi)) / 10.0;\n        }\n      } else {\n        float arc = smoothstep(0.55, 0.0, abs(h - 0.42 - 0.12 * skyNoise(vec2(az0 * 2.0 + uAuroraSeed, uTime * 0.01))));\n        float rays = pow(skyNoise(vec2(az0 * 38.0 + uAuroraSeed, uTime * 0.03)), 2.0) * (0.6 + 0.8 * skyNoise(vec2(az0 * 5.0, 3.0)));\n        float up = smoothstep(0.04, 0.2, h) * (1.0 - smoothstep(0.3, 0.95, h));\n        vec3 c = mix(uAuroraLow, uAuroraTop, smoothstep(0.1, 0.8, h));\n        a += c * rays * arc * up * 0.9 + uAuroraMid * arc * up * 0.12;\n      }\n      col += a * uAurora * 3.0 * (1.0 - sunUp) * smoothstep(0.04, 0.3, h);\n    }\n\n    /* moon: disc and halo */\n    if (uMoon > 0.0) {\n      float md = max(dot(d, uMoonDir), 0.0);\n      col += vec3(0.85, 0.9, 1.0) * (smoothstep(0.00042, 0.00028, 1.0 - md) * 2.2 + pow(md, 300.0) * 0.5 + pow(md, 24.0) * 0.07) * uMoon;\n    }\n\n    /* rainbow opposite the sun: 40 to 43 degrees from the antisolar point, only while the sun is up and the sky is clear */\n    if (uRainbow > 0.0 && sunUp > 0.1 && h > 0.0) {\n      float ang = acos(clamp(dot(d, -uSunDir), -1.0, 1.0));\n      float t = (ang - 0.70) / 0.075;\n      if (t > 0.0 && t < 1.0) {\n        vec3 rb = clamp(abs(mod(t * 6.0 + vec3(0.0, 4.0, 2.0), 6.0) - 3.0) - 1.0, 0.0, 1.0);\n        col = mix(col, col + rb * 0.7, uRainbow * sin(t * 3.14159) * sunUp * smoothstep(0.0, 0.1, h));\n      }\n    }\n\n    /* crepuscular rays: angular streaks around the sun, strongest when the sun is low */\n    if (uSunRays > 0.0 && sunUp > 0.0) {\n      vec3 sr = normalize(cross(uSunDir, vec3(0.0, 1.0, 0.0001))), su = cross(sr, uSunDir);\n      float ang = atan(dot(d, su), dot(d, sr));\n      float streak = skyNoise(vec2(ang * 7.0, uTime * 0.01)) * 0.6 + skyNoise(vec2(ang * 19.0, 4.0)) * 0.4;\n      col += uGlow * pow(sd, 3.0) * streak * uSunRays * (1.0 - clamp(uSunDir.y * 1.5, 0.0, 0.8));\n    }\n\n    /* city glow hugging the horizon on the far side */\n    col += uCityColor * uCityGlow * pow(1.0 - clamp(h * 3.0, 0.0, 1.0), 3.0) * (1.0 - sunUp);\n\n    /* cumulus + high cirrus.  Low in the sky the clouds are mapped on a cylinder (azimuth, elevation) so they keep their\n       height as tall towers; overhead they are mapped on a plane.  The two blend between 16 and 30 degrees.  A flat\n       base cuts every cloud at constant elevation (the look of Complementary's cumulus). */\n    if (h > 0.01 && uCover > 0.0) {\n      float az = atan(d.x, -d.z);\n      float sunAz = atan(uSunDir.x, -uSunDir.z);\n      float wP = smoothstep(0.28, 0.5, h), wC = 1.0 - wP;\n      vec2 drift = vec2(uTime * 0.004, uTime * 0.0015);\n      float dens = 0.0, shC = 0.0, shP = 0.0;\n      if (wC > 0.001) {\n        vec2 p = vec2(az * 4.0, h * uCloudVert) * uCloudScale * 2.2 + drift;\n        float dA = sunAz - az; dA = dA - 6.2831853 * floor((dA + 3.1415927) / 6.2831853);\n        vec2 ts = normalize(vec2(dA * 2.0, (uSunDir.y - h) * 4.0 + 0.0001)) * 0.2;\n        float dc = cloudDensity(p);\n        if (dc > 0.002) shC = cloudDensity(p + ts) * 0.4 + cloudDensity(p + ts * 2.6) * 0.35 + cloudDensity(p + ts * 5.5) * 0.25;\n        dens += dc * wC;\n      }\n      if (wP > 0.001) {\n        float t = uCloudAlt / (h + 0.22);\n        vec2 p = d.xz * t * uCloudScale + drift;\n        vec2 toSun = normalize(uSunDir.xz + 1e-4) * 0.16;\n        float dp = cloudDensity(p);\n        if (dp > 0.002) shP = cloudDensity(p + toSun) * 0.4 + cloudDensity(p + toSun * 2.6) * 0.35 + cloudDensity(p + toSun * 5.5) * 0.25;\n        dens += dp * wP;\n      }\n      dens *= smoothstep(uCloudBase, uCloudBase + 0.05, h);\n      if (dens > 0.002) {\n        float sh = shC * wC + shP * wP;\n        float lit = smoothstep(0.0, 1.0, clamp(1.0 - sh * uCloudDark, 0.0, 1.0));\n        vec3 body = mix(uCloudShade, uCloudLit, lit);\n        float edge = clamp(1.0 - dens * 1.6, 0.0, 1.0);                  // thin edges catch the sun\n        body += uSunColor * pow(sd, 8.0) * edge * 0.25 * lit;\n        body *= mix(0.35, 1.0, sunUp);                                    // night clouds are dim\n        float fade = smoothstep(0.0, 0.2, h);                             // melt into the horizon haze\n        col = mix(col, mix(body, uHorizon, uHaze * (1.0 - fade)), dens * fade);\n      }\n      if (uCloudLayerHigh > 0.0) {\n        float t2 = (uCloudAlt * 2.6) / h;\n        vec2 q = d.xz * t2 * uCloudScale * vec2(0.5, 1.8) + vec2(uTime * 0.002, 4.0);\n        float ci = smoothstep(0.58, 0.95, skyFbm(q * 1.4)) * smoothstep(0.02, 0.25, h);\n        col = mix(col, mix(uCloudLit, uGlow, 0.35 * pow(sd, 3.0)), ci * uCloudLayerHigh * (0.4 + 0.6 * sunUp));\n      }\n    }\n    return col;\n  }\n\n  void main(){\n    gl_FragColor = vec4(skyColor(normalize(vDir)) * uExposure, 1.0);\n  }","lights":false,"clipping":false},{"uuid":"e3662865-13c3-4617-bf92-e1433c6f6af3","type":"ShaderMaterial","blending":2,"transparent":true,"blendColor":0,"depthWrite":false,"forceSinglePass":true,"fog":false,"glslVersion":null,"uniforms":{"uTime":{"value":2.974999999999997},"uSize":{"value":0.03},"uScale":{"value":540},"uBox0":{"type":"v3","value":[-4,0.4,-9]},"uBoxSize":{"type":"v3","value":[12,5.6,17]},"uFocus":{"type":"v3","value":[2,3,-2]},"uFocusR":{"value":8},"uColor":{"type":"c","value":16773336},"uOpacity":{"value":0.5}},"vertexShader":"\n  uniform float uTime, uSize, uScale;\n  uniform vec3 uBox0, uBoxSize, uFocus; uniform float uFocusR;\n  attribute vec4 aSeed;\n  varying float vA;\n  void main(){\n    vec3 p = uBox0 + uBoxSize * aSeed.xyz;\n    float t = uTime * (0.012 + aSeed.w * 0.016); /* slow drift: fast specks read as flicker */\n    p += vec3(sin(t * 3.1 + aSeed.w * 40.0), sin(t * 2.3 + aSeed.x * 31.0) * 0.6 + t * 0.1, cos(t * 2.7 + aSeed.y * 27.0)) * 0.18;\n    p = uBox0 + mod(p - uBox0, uBoxSize);\n    vec4 mv = modelViewMatrix * vec4(p, 1.0);\n    gl_Position = projectionMatrix * mv;\n    float tw = 0.8 + 0.2 * sin(uTime * 0.07 + aSeed.z * 20.0); /* no twinkle: brightness stays steady */\n    float f = uFocusR > 0.0 ? 1.0 - smoothstep(0.0, uFocusR, distance(p, uFocus)) : 1.0;\n    vA = tw * f * (0.4 + 0.6 * aSeed.w);\n    gl_PointSize = clamp(uSize * uScale * (0.6 + aSeed.w * 0.8) / max(0.2, -mv.z), 1.0, 5.0);\n  }","fragmentShader":"\n  uniform vec3 uColor; uniform float uOpacity; varying float vA;\n  void main(){\n    float d = length(gl_PointCoord - 0.5) * 2.0;\n    float a = smoothstep(1.0, 0.0, d); a *= a;\n    gl_FragColor = vec4(uColor, a * vA * uOpacity);\n  }","lights":false,"clipping":false},{"uuid":"62361ad8-4d4a-4b8d-8ff8-79a320e4bbbc","type":"MeshBasicMaterial","color":16773852,"alphaMap":"f9e1be09-7c01-48a8-810a-aaa147167d37","envMapRotation":[0,0,0,"XYZ"],"reflectivity":1,"refractionRatio":0.98,"blending":2,"opacity":0.07,"transparent":true,"blendColor":0,"depthWrite":false,"toneMapped":false,"fog":false,"userData":{"kind":"flat"}},{"uuid":"c3e9b49e-113a-44e3-aead-872af839ef54","type":"MeshBasicMaterial","color":16773852,"alphaMap":"f9e1be09-7c01-48a8-810a-aaa147167d37","envMapRotation":[0,0,0,"XYZ"],"reflectivity":1,"refractionRatio":0.98,"blending":2,"opacity":0.09,"transparent":true,"blendColor":0,"depthWrite":fals