wMatrix * w; }","fragmentShader":"\n  uniform float uT; uniform vec3 uTop, uMid, uBot;\n  varying vec3 vW;\n  float h11(float n){ return fract(sin(n * 91.345) * 47453.5453); }\n  void main(){\n    float u = clamp((vW.y - 0.98) / 0.76, 0.0, 1.0);\n    vec3 col = mix(uBot, uMid, smoothstep(0.0, 0.5, u));\n    col = mix(col, uTop, smoothstep(0.45, 1.0, u));\n    float side = vW.x > 0.0 ? 1.0 : -1.0;\n    float zz = vW.z - uT * 0.5 + (side > 0.0 ? 0.0 : 1.7);\n    /* tunnel segments: a dark joint every 0.9 m (a pane is ~1.3 m wide: always one or two in view) */\n    float r = fract(zz / 0.9);\n    float joint = smoothstep(0.0, 0.08, r) * smoothstep(1.0, 0.86, r);\n    col *= 0.22 + 0.78 * joint;\n    col += vec3(0.012, 0.012, 0.02) * joint * smoothstep(0.5, 0.0, abs(r - 0.5));\n    /* cable runs, sagging between hangers */\n    col += vec3(0.05, 0.05, 0.08) * smoothstep(0.012, 0.0, abs(vW.y - 1.12 - 0.02 * abs(sin(zz * 3.49))));\n    col += vec3(0.04, 0.04, 0.06) * smoothstep(0.010, 0.0, abs(vW.y - 1.30));\n    /* lamp strips every 2.4 m: a hard bright core, a halo, and their light on the wall */\n    float c = zz / 2.4, id = floor(c), f = (fract(c) - 0.5) * 2.4;\n    vec3 lampCol = h11(id + 1.0) > 0.78 ? vec3(0.72, 0.84, 1.0) : vec3(1.0, 0.76, 0.46);\n    float dy = vW.y - 1.52;\n    float core = smoothstep(0.24, 0.17, abs(f)) * smoothstep(0.045, 0.02, abs(dy));\n    float halo = exp(-(f * f) / 0.18 - (dy * dy) / 0.02);\n    float pool = exp(-(f * f) / 0.6) * (0.35 + 0.65 * smoothstep(1.0, 0.2, u)) * (0.4 + 0.6 * joint);\n    col += lampCol * (core * 2.2 + halo * 0.6 + pool * 0.14);\n    /* now and then a signal: a red or green dot low on the wall */\n    float c3 = zz / 31.0, f3 = (fract(c3) - 0.5) * 31.0, id3 = floor(c3);\n    vec3 sig = h11(id3 + 9.0) > 0.5 ? vec3(0.2, 1.0, 0.45) : vec3(1.0, 0.18, 0.14);\n    col += sig * exp(-(f3 * f3) / 0.02 - pow(vW.y - 1.08, 2.0) / 0.002) * 1.2;\n    /* interior reflection: a pale diagonal sheet and the warm red of the benches low in the pane */\n    float sheet = smoothstep(0.0, 0.18, 0.5 - abs(u - (0.55 + 0.12 * sin(vW.z * 0.35 + 1.0))));\n    col += vec3(0.30, 0.27, 0.46) * sheet * 0.05;\n    col += vec3(0.30, 0.06, 0.10) * (1.0 - smoothstep(0.0, 0.35, u)) * 0.05;\n    gl_FragColor = vec4(col, 1.0);\n  }","lights":false,"clipping":false},{"uuid":"e1156e9c-4ecb-4f8b-9e61-82de423bda6a","type":"MeshBasicMaterial","color":14868223,"alphaMap":"2d799043-b722-4ace-a8ff-16160c3557db","envMapRotation":[0,0,0,"XYZ"],"reflectivity":1,"refractionRatio":0.98,"blending":2,"side":2,"opacity":0.4,"transparent":true,"blendColor":0,"depthWrite":false,"toneMapped":false,"fog":false,"userData":{"kind":"flat"}},{"uuid":"e6d8e4f0-3a7c-4df9-a8ff-f08b7cbad76c","type":"MeshBasicMaterial","color":11182828,"alphaMap":"2d799043-b722-4ace-a8ff-16160c3557db","envMapRotation":[0,0,0,"XYZ"],"reflectivity":1,"refractionRatio":0.98,"blending":2,"side":2,"opacity":0.22,"transparent":true,"blendColor":0,"depthWrite":false,"toneMapped":false,"fog":false,"userData":{"kind":"flat"}},{"uuid":"1d17c9c0-5b68-4231-8f05-3f0147c7259e","type":"MeshBasicMaterial","color":9077964,"alphaMap":"2d799043-b722-4ace-a8ff-16160c3557db","envMapRotation":[0,0,0,"XYZ"],"reflectivity":1,"refractionRatio":0.98,"blending":2,"side":2,"opacity":0.14,"transparent":true,"blendColor":0,"depthWrite":false,"toneMapped":false,"fog":false,"userData":{"kind":"flat"}},{"uuid":"f7db84cc-3e2d-44d3-851d-2a04fac64c91","type":"MeshBasicMaterial","color":11577576,"alphaMap":"2d799043-b722-4ace-a8ff-16160c3557db","envMapRotation":[0,0,0,"XYZ"],"reflectivity":1,"refractionRatio":0.98,"blending":2,"side":2,"opacity":0.11459076093055579,"transparent":true,"blendColor":0,"depthWrite":false,"toneMapped":false,"fog":false,"userData":{"kind":"flat"}},{"uuid":"4b170bcd-535f-4805-b5ee-02a768bb4947","type":"MeshBasicMaterial","color":9406680,"alphaMap":"2d799043-b722-4ace-a8ff-16160c3557db","envMapRotation":[0,0,0,"XYZ"],"reflectivity":1,"refractionRatio":0.98,"blending":2,