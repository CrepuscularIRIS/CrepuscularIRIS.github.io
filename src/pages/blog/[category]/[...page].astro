---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import { Paginator, PostPreview, CollectionPreview } from '@/components/pages'
import { getBlogCollection, getUniqueCategories, getCollectionsByCategory, getCollectionsByHie, getUniqueTags, sortMDByDate, getPostCollections } from '@/server'
import { Button, Icon } from '@/components/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import config from '@/site-config'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  // Two-bucket nav. Each bucket aggregates a subset of the 5-hIE writing
  // taxonomy AND any legacy `category:` values that semantically belong to it.
  // The 5 hIE detail pages are still reachable individually below.
  const BUCKETS: Array<[string, string, string[], string[], string]> = [
    // [url-slug, display-name, hIE-codes, legacy-category-values, sub-label]
    ['engineering', 'Engineering',
      ['methode', 'saturnus'],
      ['tech', 'technical', 'engineering', 'updates'],
      'Build · Audit · Tech'],
    ['research',    'Research',
      ['snowdrop', 'kouka', 'lacia'],
      ['research', 'interpretation', 'opinion'],
      'Papers · Signals · Digest']
  ]

  // Per-hIE detail routes — same template, drilldown view.
  const HIE_SLUGS: Array<[string, string, string]> = [
    // [url-slug, hIE-code, display-name]
    ['papers',  'snowdrop', 'Papers'],
    ['signals', 'kouka',    'Signals'],
    ['audit',   'saturnus', 'Audit'],
    ['build',   'methode',  'Build'],
    ['digest',  'lacia',    'Digest']
  ]

  // Legacy category names kept for backward-compat URLs.
  const legacyCategoryMap: Record<string, string> = {
    'tech': 'Technical',
    'daily': 'Daily Life',
    'journal': 'Month Journal',
    'interpretation': 'Interpretation',
    'technical': 'Technical',
    'updates': 'Updates',
    'opinion': 'Opinion'
  }

  // Display name lookup combines bucket labels + hIE labels + legacy categories.
  const categoryMap: Record<string, string> = { ...legacyCategoryMap }
  for (const [slug, , label] of HIE_SLUGS) categoryMap[slug] = label
  for (const [slug, label] of BUCKETS) categoryMap[slug] = label

  const allCollections = await getBlogCollection()

  const bucketSlugs = BUCKETS.map(([slug]) => slug)
  const hieSlugs = HIE_SLUGS.map(([slug]) => slug)
  const legacyCategoryOrder = ['interpretation', 'tech', 'technical', 'opinion', 'updates', 'daily', 'journal']
  const allUniqueCategories = getUniqueCategories(allCollections)
  const liveLegacy = legacyCategoryOrder.filter(cat => allUniqueCategories.includes(cat))

  // Circular prev/next is between the two buckets only — the simple top-level nav.
  const navOrder = bucketSlugs

  const allRoutes = [...bucketSlugs, ...hieSlugs, ...liveLegacy]

  return allRoutes.flatMap((slug, _idx) => {
    const bucketEntry = BUCKETS.find(([s]) => s === slug)
    const hieEntry = HIE_SLUGS.find(([s]) => s === slug)
    const collections = sortMDByDate(
      bucketEntry
        // Bucket route: union of hIE codes + legacy categories that map to this bucket.
        ? [
            ...bucketEntry[2].flatMap(code => getCollectionsByHie(allCollections, code)),
            ...bucketEntry[3].flatMap(legacy => getCollectionsByCategory(allCollections, legacy))
          ]
        : hieEntry
          ? getCollectionsByHie(allCollections, hieEntry[1])
          : getCollectionsByCategory(allCollections, slug)
    )
    // De-dup if a post has both an hIE code in two buckets (shouldn't, but defensive).
    const seen = new Set<string>()
    const dedupCollections = collections.filter(c => {
      if (seen.has(c.id)) return false
      seen.add(c.id)
      return true
    })
    const uniqueTags = getUniqueTags(dedupCollections)
    const collectionsCount = dedupCollections.length

    // Circular prev/next over the 2-bucket nav. Detail/legacy pages get the first/last bucket.
    const navIdx = navOrder.indexOf(slug)
    const prevCategory = navIdx >= 0
      ? navOrder[navIdx === 0 ? navOrder.length - 1 : navIdx - 1]
      : navOrder[navOrder.length - 1]
    const nextCategory = navIdx >= 0
      ? navOrder[navIdx === navOrder.length - 1 ? 0 : navIdx + 1]
      : navOrder[0]

    return paginate(dedupCollections, {
      params: { category: slug },
      pageSize: config.content?.blogPageSize || 8,
      props: { uniqueTags, collectionsCount, category: slug, prevCategory, nextCategory, categoryMap }
    })
  })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'blog'>>
  uniqueTags: string[]
  collectionsCount: number
  category: string
  prevCategory: string
  nextCategory: string
  categoryMap: Record<string, string>
}

const { page, uniqueTags, collectionsCount, category, prevCategory, nextCategory, categoryMap: categoryMapProp } = Astro.props

const categoryDisplayName = categoryMapProp[category] || category
const postCollections = await getPostCollections()

const meta = {
  description: `Posts in category: ${categoryDisplayName}`,
  title: `${categoryDisplayName} - Blog`
}
---

<PageLayout {meta}>
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <div class='category-nav-wrapper mb-6 mt-6 sm:mt-10'>
        <h1 class='inline-block text-3xl font-medium'>{categoryDisplayName}</h1>
        <div class='category-nav-arrows ml-3 inline-flex gap-1 align-middle'>
          <a 
            href={`/blog/${prevCategory}`}
            class='flex h-8 w-8 items-center justify-center transition-colors hover:text-primary'
            title={`Previous: ${categoryMapProp[prevCategory]}`}
            aria-label={`Go to ${categoryMapProp[prevCategory]}`}
          >
            <Icon name='up' class='size-5' />
          </a>
          <a 
            href={`/blog/${nextCategory}`}
            class='flex h-8 w-8 items-center justify-center transition-colors hover:text-primary'
            title={`Next: ${categoryMapProp[nextCategory]}`}
            aria-label={`Go to ${categoryMapProp[nextCategory]}`}
          >
            <Icon name='chevron-down' class='size-5' />
          </a>
        </div>
      </div>
    </div>
    {
      page.data.length === 0 ? (
        <p>No posts yet.</p>
      ) : (
        <div class='grid gap-y-16 sm:grid-cols-[3fr_1fr] sm:gap-x-8'>
          <section aria-label='Blog posts list' class='animate' id='content'>
            {/* header */}
            <div class='mb-3 flex flex-col justify-between text-sm sm:mb-5 sm:flex-row'>
              <span class='text-muted-foreground'>
                Page {page.currentPage} - Showing {page.data.length} of {collectionsCount} posts
              </span>
              <a aria-label='View all blog by years' href='/archives' data-astro-prefetch>
                View all posts by years →
              </a>
            </div>
            {/* posts */}
            <ul class='flex flex-col gap-y-4 text-start'>
              {page.data.map((post) => (
                <PostPreview {post} detailed />
              ))}
            </ul>
            <Paginator currentPage={page.currentPage} lastPage={page.lastPage} url={page.url} />
          </section>

          {/* sidebar */}
          {(!!uniqueTags.length || !!postCollections.length) && (
            <aside class='animate' id='sidebar'>
              {!!postCollections.length && (
                <div class='mb-8'>
                  <h2 class='mb-4 flex items-center text-lg font-semibold'>
                    <Icon name='package' class='me-2' />
                    Collections
                  </h2>
                  <ul class='flex flex-col gap-2'>
                    {postCollections.slice(0, 5).map((collection) => (
                      <CollectionPreview {collection} minimal />
                    ))}
                  </ul>
                  <span class='mt-4 block sm:text-end'>
                      <a aria-label='View all collections' href='/collection' data-astro-prefetch>
                      View all →
                      </a>
                  </span>
                </div>
              )}
              {!!uniqueTags.length && (
                <div>
                  <h2 class='mb-4 flex items-center text-lg font-semibold'>
                    <Icon name='tag-2' class='me-2' />
                    Tags
                  </h2>
                  <ul class='text-bgColor flex flex-wrap gap-2'>
                    {uniqueTags.map((tag) => (
                      <li>
                        <Button title={tag} href={`/tags/${tag}`} style='pill' />
                      </li>
                    ))}
                  </ul>
                  <span class='mt-4 block sm:text-end'>
                    <a aria-label='View all blog categories' href='/tags' data-astro-prefetch>
                      View all →
                    </a>
                  </span>
                </div>
              )}
            </aside>
          )}
        </div>
      )
    }
  </main>
</PageLayout>
